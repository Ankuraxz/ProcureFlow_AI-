# syntax=docker/dockerfile:1.7
# ==============================================================================
# ProcureFlow AI — Multi-Stage Frontend UI Container (Node 22 -> Nginx Alpine)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Static Asset Build (Node 22 Alpine)
# ------------------------------------------------------------------------------
FROM node:22-alpine AS ui-builder

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Production Static Server & Reverse Proxy (Nginx Alpine on Port 8080)
# ------------------------------------------------------------------------------
FROM nginx:alpine AS runtime

LABEL org.opencontainers.image.title="procureflow-ui" \
      org.opencontainers.image.description="ProcureFlow AI — React + Vite Declarative A2UI & AP2 Signer Client" \
      org.opencontainers.image.licenses="Apache-2.0"

# Restrict envsubst to GATEWAY_URL only so native Nginx $uri/$host variables remain untouched
ENV GATEWAY_URL="http://concierge-gateway:8000" \
    NGINX_ENVSUBST_FILTER="^GATEWAY_URL$"

RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=ui-builder /app/frontend/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
