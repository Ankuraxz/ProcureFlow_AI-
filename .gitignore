# ==============================================================================
# ProcureFlow AI — Git Ignore Rules
# ==============================================================================

# Secrets & local environment files (NEVER commit API keys or private seeds)
.env
.env.*
!.env.example

# Python virtual environments & build artifacts
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local SQLite runtime databases & WAL files
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3

# Frontend dependencies & build outputs
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Terraform local state & variable overrides
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/crash.log
infra/terraform/*.tfvars
infra/terraform/*.tfvars.json
!infra/terraform/*.tfvars.example

# macOS / Editor metadata
.DS_Store
.idea/
.vscode/
*.swp
*.swo
