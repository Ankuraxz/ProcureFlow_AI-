# ==============================================================================
# ProcureFlow AI — Environment Configuration Template
# Copy this file to `.env` and populate `GOOGLE_API_KEY` before running locally:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Credentials (Required for live LLM & Eval Judge calls)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-gemini-api-key-here
# Optional alias recognized by the evaluation harness & GitHub Actions CI:
# GEMINI_API_KEY=your-google-gemini-api-key-here

# ------------------------------------------------------------------------------
# 2. Model Tier Routing (Coordinator vs Specialized Task SLMs vs Eval Judge)
# ------------------------------------------------------------------------------
ORCHESTRATOR_MODEL=gemini-3.5-flash
SLM_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------------------
# 3. Local Service Ports & Over-the-Wire A2A Endpoints
# ------------------------------------------------------------------------------
HOST=127.0.0.1
GATEWAY_PORT=8000
CATALOG_PORT=8001
POLICY_PORT=8002
SETTLEMENT_PORT=8003
UI_PORT=5173

CATALOG_A2A_URL=http://127.0.0.1:8001
POLICY_A2A_URL=http://127.0.0.1:8002
SETTLEMENT_A2A_URL=http://127.0.0.1:8003

# ------------------------------------------------------------------------------
# 4. Four-Tier Hybrid Memory & SQLite Persistence Paths
# ------------------------------------------------------------------------------
SKILLS_DIR=./skills
DATA_DIR=./data
SESSION_DB_PATH=./data/procureflow_sessions.db
DOMAIN_DB_PATH=./data/procureflow_domain.db

# ------------------------------------------------------------------------------
# 5. AP2 (Agent Payments Protocol) Governance & Cryptographic Seed
# ------------------------------------------------------------------------------
# Orders <= $500 from PREFERRED/APPROVED vendors with < 80% post-order budget
# utilization execute autonomously under a pre-signed IntentMandate; otherwise
# execution pauses for human Ed25519 CartMandate approval.
AP2_AUTO_LIMIT_USD=500.00
AP2_MAX_BUDGET_UTILIZATION=0.80

# Optional 64-char hex seed for deterministic Ed25519 settlement keys across restarts.
# Leave blank locally to auto-generate/persist a local development keypair.
AP2_ED25519_SEED=

# ------------------------------------------------------------------------------
# 6. OpenTelemetry, Token FinOps & Google Cloud Run Integration
# ------------------------------------------------------------------------------
OTEL_SERVICE_NAME=procureflow-ai
ENABLE_CLOUD_TRACE=false
CLOUD_RUN_IAM_AUTH=false
GCP_PROJECT_ID=
